# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local database
local.db

# generated playground build artifacts
/public/playground/*
!/public/playground/shadcn-examples.json
/.generated/

# vercel
.vercel

# cloudflare / opennext
/.open-next/
/.wrangler/
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts


.opencode
.claude
.vscode
.agents
scripts/*
!scripts/build-playground-modules.ts
!scripts/build-playground-types.ts
!scripts/sync-shadcn-examples.ts
# Nightshift plan artifacts (keep out of version control)
.nightshift-plan
